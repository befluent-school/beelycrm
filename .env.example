# ─── Banco de dados (Postgres local na VPS, ou local de dev) ──
# Produção (VPS): postgresql://beely:SENHA@127.0.0.1:5432/beely_crm
# Dev local: cluster próprio em .pgdata (porta 5436) — NUNCA o Postgres do
# sistema na 5432 (ver deploy/README.md).
DATABASE_URL=postgresql://beely:SENHA@127.0.0.1:5432/beely_crm

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# Segredo da aplicação — nunca reaproveite entre ambientes.
# Gere com: openssl rand -hex 32
APP_SECRET=

# Em produção, protege /api/cron/* e /api/debug/* contra chamadas anônimas
# — sem essas vars configuradas, essas rotas ficam bloqueadas por padrão
# (fail-closed), nunca abertas por esquecimento.
CRON_SECRET=
DEBUG_ADMIN_SECRET=

# ─── Modo demo ──────────────────────────────────────────────
# Quando true (ou sem DATABASE_URL configurado), o app usa dados mockados
# e sessão em cookie simples — útil para navegar sem banco/infra.
NEXT_PUBLIC_DEMO_MODE=false

# ─── Autenticação própria ───────────────────────────────────
SESSION_DAYS=30

# ─── Google OAuth — LOGIN no Beely ──────────────────────────
# Distinto do OAuth do Gmail/Calendar abaixo (aquele é para enviar e-mail/
# criar evento EM NOME da conta de remarketing; este é para autenticar
# quem está entrando no Beely). Pode usar o mesmo projeto/Client ID do
# Google Cloud Console, mas o redirect URI é diferente.
# 1. console.cloud.google.com → mesmo projeto (ou novo)
# 2. Credentials → Create OAuth client ID → tipo "Web application"
# 3. Authorized redirect URI: https://SEU-APP/auth/callback
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:3000/auth/callback

# ─── SMTP (Hostinger) — e-mails transacionais (reset de senha) ─
# No painel Hostinger: E-mails → crie uma caixa (ex.: nao-responda@seudominio.com.br)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=nao-responda@seudominio.com.br
SMTP_PASS=
EMAIL_FROM="Beely <nao-responda@seudominio.com.br>"

# ─── Remarketing por e-mail — Gmail API (OAuth) ────────────────
# Envia de verdade como befluentschooll@gmail.com. Passos:
# 1. console.cloud.google.com → novo projeto (ou o mesmo do login)
# 2. APIs & Services → Enable APIs → "Gmail API"
# 3. Credentials → Create OAuth client ID → tipo "Web application"
# 4. Authorized redirect URI: https://SEU-APP/api/remarketing/oauth/callback
# 5. OAuth consent screen: scope https://www.googleapis.com/auth/gmail.send
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/remarketing/oauth/callback
REMARKETING_FROM_EMAIL=befluentschooll@gmail.com
REMARKETING_FROM_NAME=Be Fluent

# ─── Google Calendar + Meet — agendamento de reuniões ──────────
# Mesmo Client ID/Secret do Gmail acima, redirect URI próprio.
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/calendar/oauth/callback

# ─── Resend (opcional — melhor entregabilidade em volume) ──────
# Exige domínio verificado (SPF/DKIM). Não permite "enviar como @gmail.com".
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ─── Ligações com IA — Vapi ───────────────────────────────────
# 1. dashboard.vapi.ai → API Keys → copie a "Private Key"
# 2. Phone Numbers → compre/importe um número → copie o Phone Number ID
# 3. Assistants → crie um assistant (voz + modelo + system prompt) → copie o ID
# 4. Configure o Server URL do assistant/número para:
#    https://SEU-APP/api/calls/webhook
# VAPI_WEBHOOK_SECRET é obrigatório em produção (sem ele, o webhook recusa
# tudo por padrão — fail-closed).
VAPI_PRIVATE_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=
VAPI_WEBHOOK_SECRET=

# ─── Twilio (opcional — stack self-hosted Twilio + OpenAI Realtime) ─
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── WhatsApp (Z-API / Meta Cloud API) — modo legado de instância única ─
# Só necessário se você ainda usa o modo pré-multi-SDR (sem sdrId na URL do
# webhook). Com SDRs configurados em Configurações → SDRs & WhatsApp, cada
# um guarda suas próprias credenciais no banco — essas vars não são usadas.
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
NEXT_PUBLIC_ZAPI_INSTANCE_ID=
NEXT_PUBLIC_ZAPI_TOKEN=
WHATSAPP_VERIFY_TOKEN=beely2024

# ─── Instagram / Messenger (Meta Graph API) ────────────────────
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=beely2024
MESSENGER_APP_SECRET=
MESSENGER_VERIFY_TOKEN=beely2024
