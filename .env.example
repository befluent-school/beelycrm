# ─── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Postgres connection string (for Drizzle migrations) — use the "Session/Direct" connection
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.YOUR-PROJECT.supabase.co:5432/postgres

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# ─── Remarketing por e-mail — Gmail API (OAuth) ────────────────
# Envia de verdade como befluentschooll@gmail.com. Passos:
# 1. console.cloud.google.com → novo projeto
# 2. APIs & Services → Enable APIs → "Gmail API"
# 3. Credentials → Create OAuth client ID → tipo "Web application"
# 4. Authorized redirect URI: https://SEU-APP/api/remarketing/oauth/callback
# 5. OAuth consent screen: scope https://www.googleapis.com/auth/gmail.send
#    (mantenha em "Testing" com befluentschooll@gmail.com como test user, ou publique)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/remarketing/oauth/callback
REMARKETING_FROM_EMAIL=befluentschooll@gmail.com
REMARKETING_FROM_NAME=Be Fluent

# ─── Resend (opcional — melhor entregabilidade em volume) ──────
# Exige domínio verificado (SPF/DKIM). Não permite "enviar como @gmail.com".
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ─── Ligações com IA — Vapi ───────────────────────────────────
# 1. dashboard.vapi.ai → API Keys → copie a "Private Key"
# 2. Phone Numbers → compre/importe um número → copie o Phone Number ID
# 3. Assistants → crie um assistant (voz + modelo + system prompt) → copie o ID
# 4. Configure o Server URL do assistant/número para:
#    https://SEU-APP/api/calls/webhook
VAPI_PRIVATE_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=
VAPI_WEBHOOK_SECRET=

# ─── Twilio (opcional — stack self-hosted Twilio + OpenAI Realtime) ─
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Stripe (assinaturas + trial) ──────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_BUSINESS=price_xxx
STRIPE_PRICE_ENTERPRISE=price_xxx

# ─── Asaas (opcional: PIX/boleto BR) ───────────────────────────
ASAAS_API_KEY=

# ─── Modo demo ─────────────────────────────────────────────────
# Quando true (ou sem credenciais Supabase), o app usa dados mockados
# para navegação/demonstração sem banco de dados.
NEXT_PUBLIC_DEMO_MODE=true
